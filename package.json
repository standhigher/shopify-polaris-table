{
  "name": "@standhigher/shopify-polaris-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "website"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs:api": "typedoc --options website/typedoc.json",
    "docs:build": "npm run build && npm run docs:api && npm --prefix website run build",
    "docs:start": "npm --prefix website run start"
  },
  "peerDependencies": {
    "@shopify/polaris": ">=12 <15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@shopify/polaris": "^13.9.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
