{
  "name": "@standhigher/polaris-data-table",
  "version": "2.0.0-beta.1",
  "description": "Controlled, server-driven data tables for Shopify Polaris applications.",
  "keywords": [
    "typescript",
    "react",
    "shopify",
    "polaris",
    "data-table",
    "admin",
    "ecommerce",
    "server-driven",
    "pagination",
    "filtering",
    "bulk-actions",
    "embedded-app"
  ],
  "homepage": "https://github.com/standhigher/shopify-polaris-table#readme",
  "bugs": {
    "url": "https://github.com/standhigher/shopify-polaris-table/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standhigher/shopify-polaris-table.git"
  },
  "author": "StandHigher",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "default": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "!dist/experimental",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "workspaces": [
    "website"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "node test/runtime/p6-runtime.mjs",
    "test:runtime:update": "node test/runtime/p6-runtime.mjs --update-baselines",
    "test:visual-helper": "python3 -m unittest test/runtime/test_visual_compare.py",
    "test:polaris2": "npm --prefix test/fixtures/polaris2 ci --ignore-scripts && npm --prefix test/fixtures/polaris2 run typecheck && npm --prefix test/fixtures/polaris2 run test:ssr",
    "test:compatibility": "node --test test/compatibility-policy.node.mjs",
    "test:package": "npm run build && node --test test/package-entry.node.mjs test/package-consumer.node.mjs",
    "lint": "eslint .",
    "prepublishOnly": "node scripts/release-preflight.mjs --npm-lifecycle",
    "npm:login": "npm login --auth-type=web --registry=https://registry.npmjs.org/",
    "npm:whoami": "npm whoami --registry=https://registry.npmjs.org/",
    "npm:publish": "node scripts/publish-disabled.mjs",
    "test:beta-policy": "node --test test/beta-release-policy.node.mjs test/release-preflight.node.mjs",
    "test:tree-shaking": "npm run build && node --test test/tree-shaking.node.mjs test/package-bundle.node.mjs",
    "release:prepare:beta": "npm run release:check && npm run test:beta-policy && npm run test:tree-shaking",
    "release:check:beta": "npm run release:prepare:beta && npm run release:preflight:beta",
    "release:preflight:beta": "node scripts/release-preflight.mjs --channel next",
    "npm:publish:beta": "npm run release:check:beta && npm run release:preflight:beta && npm publish --access public --tag next --auth-type=web --registry=https://registry.npmjs.org/",
    "build-storybook": "storybook build --output-dir website/static/storybook",
    "docs:api": "typedoc --options website/typedoc.json",
    "docs:build": "npm run build-storybook && npm run build && npm run docs:api && npm --prefix website run build",
    "docs:start": "npm --prefix website run start",
    "release:check": "npm run lint && npm test && npm run test:compatibility && npm run typecheck && npm run build && npm run build-storybook && npm run docs:build && npm pack --dry-run --registry=https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@shopify/polaris-types": "2.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "esbuild": "0.28.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "preact": "11.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.5.8",
    "tsc-alias": "1.9.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
